{
  "manifest_version": 3,
  "name": "FORMS — Fila A VALIDAR",
  "version": "1.4.0",
  "description": "Botão FORMS com a fila operacional, base, validador, status e prioridade A VALIDAR.",
  "permissions": ["storage", "notifications", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Configurar PNR", "default_popup": "popup.html", "default_icon": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon.png" } },
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
