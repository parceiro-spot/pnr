{
  "manifest_version": 3,
  "name": "WhatsApp — Avisos de Recebimento",
  "version": "1.3.0",
  "description": "Detecta confirmações WhatsApp e sincroniza automaticamente com a tabela Análise Recebimento.",
  "permissions": ["storage", "notifications", "tabs", "windows", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "action": {
    "default_title": "Configurar avisos de recebimento",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon.png" }
  },
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
