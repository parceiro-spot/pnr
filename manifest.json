{
  "manifest_version": 3,
  "name": "Análise Forms — Avisos Flutuantes",
  "version": "1.0.0",
  "description": "Mostra uma bolinha flutuante e avisa quando o Análise Forms detectar novos envios.",
  "permissions": ["storage", "notifications", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Configurar Análise Forms", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
